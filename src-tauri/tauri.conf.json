{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "vrisinglauncher",
  "version": "0.1.0",
  "identifier": "com.joaop.vrisinglauncher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "vrisinglauncher",
        "width": 1000,
        "height": 650,
        "decorations": false,
        "resizable": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ]
  }
}
