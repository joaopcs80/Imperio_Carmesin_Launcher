  "productName": "vrisinglauncher",
  "version": "1.0.1",
  "identifier": "com.joaop.vrisinglauncher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "vrisinglauncher",
        "width": 1000,
        "height": 650,
        "decorations": false,
        "resizable": false,
        "transparent": true
